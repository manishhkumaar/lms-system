# Copy to .env.local and fill in.
# Hosted project: Supabase dashboard → Project Settings → API Keys.
# Local stack (npm run db:start): use the values `npx supabase status` prints.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only: account activation from invites, and npm run db:seed. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Show one-click demo account buttons on the sign-in page.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
