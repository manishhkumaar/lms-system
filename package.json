    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "lint": "eslint src scripts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.2",
